NODE_ENV=development
PORT=5500
CLIENT_URL=http://localhost:5501
APP_URL=http://localhost:5501
APP_BASE_PATH=

DATABASE_URL=postgresql://replace-with-db-user:replace-with-db-password@postgres:5432/jwt_auth_demo?schema=public

POSTGRES_DB=jwt_auth_demo
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-strong-local-password

JWT_ACCESS_PRIVATE_KEY_PATH=server/secrets/jwt/access-current-private.pem
JWT_ACCESS_PUBLIC_KEY_PATH=server/secrets/jwt/access-current-public.pem
JWT_ACCESS_PREVIOUS_PUBLIC_KEY_PATH=
JWT_ACCESS_KID=access-20260824
JWT_ACCESS_PREVIOUS_KID=

JWT_REFRESH_PRIVATE_KEY_PATH=server/secrets/jwt/refresh-current-private.pem
JWT_REFRESH_PUBLIC_KEY_PATH=server/secrets/jwt/refresh-current-public.pem
JWT_REFRESH_PREVIOUS_PUBLIC_KEY_PATH=
JWT_REFRESH_KID=refresh-20260824
JWT_REFRESH_PREVIOUS_KID=

JWT_ACTION_PRIVATE_KEY_PATH=server/secrets/jwt/action-current-private.pem
JWT_ACTION_PUBLIC_KEY_PATH=server/secrets/jwt/action-current-public.pem
JWT_ACTION_PREVIOUS_PUBLIC_KEY_PATH=
JWT_ACTION_KID=action-20260824
JWT_ACTION_PREVIOUS_KID=

JWT_ISSUER=jwt-auth-demo
JWT_AUDIENCE=jwt-auth-demo-users

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-gmail-address
SMTP_PASSWORD=replace-with-gmail-app-password
SMTP_FROM=Demo Auth <replace-with-gmail-address>

MASTER_ADMIN_USERNAME=replace-with-admin-username
MASTER_ADMIN_PASSWORD=replace-with-strong-password

RATE_LIMIT_DEV_MULTIPLIER=20
RATE_LIMIT_DEV_WINDOW_MS=60000
TRUST_PROXY_HOPS=0
