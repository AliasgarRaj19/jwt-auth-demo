NODE_ENV=production
PORT=5500
CLIENT_URL=https://replace-with-production-domain
APP_URL=https://replace-with-production-domain
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1

DATABASE_URL=postgresql://replace-with-db-user:replace-with-db-password@postgres:5432/jwt_auth_demo?schema=public
POSTGRES_DB=jwt_auth_demo
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-strong-production-password

JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-secret
JWT_ISSUER=jwt-auth-demo
JWT_AUDIENCE=jwt-auth-demo-users

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=replace-with-gmail-address
SMTP_PASSWORD=replace-with-gmail-app-password
SMTP_FROM=Demo Auth <replace-with-gmail-address>

MASTER_ADMIN_USERNAME=replace-with-admin-username
MASTER_ADMIN_PASSWORD=replace-with-strong-password

NGINX_SERVER_NAME=replace-with-production-domain
NGINX_SSL_CERTIFICATE=/etc/ssl/certs/fullchain.pem
NGINX_SSL_CERTIFICATE_KEY=/etc/ssl/private/privkey.pem
